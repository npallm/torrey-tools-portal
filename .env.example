# Finch unified HRIS/payroll API. Get a sandbox access token via Finch Connect
# (https://dashboard.tryfinch.com) using the "finch-sandbox" provider.
FINCH_API_TOKEN=
# Optional override, e.g. for a mock server:
# FINCH_API_URL=https://api.tryfinch.com

# Local Postgres database for HR metrics.
DATABASE_URL=postgres://torrey:torrey@localhost:5432/torrey_portal

# Public base URL used to create absolute change-request approval links.
APP_BASE_URL=http://localhost:3000
